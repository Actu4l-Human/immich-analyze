# Remote Immich HTTP(S) origin, e.g. https://photos.example.com (no added /api).
# Prefer HTTPS. No local Immich, database access, or library mount is required.
IMMICH_API_URL=
# Required key with asset/search read, original download, and description update permissions.
# Multiple user keys may be comma-separated. Start with a restricted test user's library.
IMMICH_API_KEY=

# Optional Hugging Face token. Sent only to the Qwen model container.
HF_TOKEN=
# First launch downloads model weights; allow sufficient Internet bandwidth and Docker disk space.
# Override only with a compatible Qwen3-Omni checkpoint. Both clients use served name qwen-omni.
QWEN_OMNI_MODEL=Intel/Qwen3-Omni-30B-A3B-Instruct-int4-AutoRound
QWEN_OMNI_GPU_ID=0
# The model port is published on localhost only; it is not authenticated.
QWEN_OMNI_PORT=8091

# combined processes existing eligible assets and monitors newly added assets.
# Set monitor to process only assets added after its initial synchronization.
IMMICH_ANALYZE_MODE=combined
IMMICH_ANALYZE_MAX_CONCURRENT=1
IMMICH_ANALYZE_VIDEO_MAX_CONCURRENT=1
# Maximum original video size: 2 GiB. Oversized files fail; they are never truncated.
IMMICH_ANALYZE_VIDEO_MAX_BYTES=2147483648
IMMICH_ANALYZE_TIMEOUT=600
IMMICH_ANALYZE_MAX_RETRIES=3
# none skips any existing description. missing-ai processes only assets without an [AI] block.
# true skips any saved description before overwrite policy is considered; cleared descriptions remain eligible.
IMMICH_ANALYZE_OVERWRITE_POLICY=none
IMMICH_ANALYZE_SKIP_PROCESSED=false
IMMICH_ANALYZE_API_POLL_INTERVAL=10
